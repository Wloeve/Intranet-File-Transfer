root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{bat,cmd}]
end_of_line = crlf

[*.py]
end_of_line = lf
indent_style = space
indent_size = 4

[*.{md,yml,yaml}]
end_of_line = lf
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2
